{
	"name": "WeatherJsonSOURCE",
	"properties": {
		"linkedServiceName": {
			"referenceName": "WeatherHttpServer2",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"lat": {
				"type": "string",
				"defaultValue": "42.3601"
			},
			"lon": {
				"type": "string",
				"defaultValue": "-71.0589"
			},
			"start": {
				"type": "string",
				"defaultValue": "@string((ticks(addDays(utcNow(), -7 * item() - 7)) - ticks('1970-01-01T00:00:00Z')) / 10000000)"
			},
			"end": {
				"type": "string",
				"defaultValue": "@string((ticks(addDays(utcNow(), -7 * item())) - ticks('1970-01-01T00:00:00Z')) / 10000000)"
			},
			"appid": {
				"type": "string",
				"defaultValue": "6d3f27172679bc19d6d4c05b39b58d32"
			},
			"dataType": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Json",
		"typeProperties": {
			"location": {
				"type": "HttpServerLocation",
				"relativeUrl": {
					"value": "data/2.5/history/city?lat=@{dataset().lat}&lon=@{dataset().lon}&type=@{dataset().dataType}&start=@{dataset().start}&end=@{dataset().end}&appid=@{dataset().appid}",
					"type": "Expression"
				}
			}
		},
		"schema": {}
	}
}