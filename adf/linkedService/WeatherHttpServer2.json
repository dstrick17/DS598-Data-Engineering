{
	"name": "WeatherHttpServer2",
	"properties": {
		"annotations": [],
		"type": "HttpServer",
		"typeProperties": {
			"url": "https://history.openweathermap.orgdata/2.5/history/city?lat=@{dataset().lat}&lon=@{dataset().lon}&type=@{dataset().dataType}&start=@{dataset().start}&end=@{dataset().end}&appid=@{dataset().appid}",
			"enableServerCertificateValidation": true,
			"authenticationType": "Anonymous"
		}
	}
}